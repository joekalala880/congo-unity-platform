# Copy this file to .env and fill in your own values. Never commit .env.
#
# Cloudinary (profile photo uploads — see src/hooks/useProfilePhotoUpload.js)
# Both values are safe to expose to the browser: this app uses an UNSIGNED
# upload preset, so no Cloudinary API secret is ever needed or used here.
# Cloud name: found on your Cloudinary dashboard.
# Upload preset: Settings -> Upload -> Upload presets -> create one with
# "Signing Mode" set to "Unsigned".
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Identity document uploads (UploadID.jsx / useIdDocumentUpload.js).
# Unlike profile photos, ID documents are uploaded SIGNED — this must be a
# safe-to-expose URL (just an endpoint address) pointing at the
# api/cloudinary-sign serverless function. See "Identity document uploads"
# in README.md for what that function needs deployed alongside it, and why
# unsigned uploads aren't used for this feature.
VITE_ID_DOCUMENT_SIGNING_ENDPOINT=
