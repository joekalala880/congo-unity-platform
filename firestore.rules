rules_version = '2';

// Congo Unity Platform — Firestore security rules
//
// Data model notes (see PROJECT_OVERVIEW / security audit summary for detail):
// - congoleseProfiles: one profile per registered user. Currently created with
//   an auto-generated document ID (see Register.jsx), with a `userId` field
//   holding the Firebase Auth uid. Ownership checks below compare
//   resource.data.userId to request.auth.uid, which works regardless of doc ID.
// - The isAdmin() helper below looks up the CALLER's own profile by uid-as-doc-ID
//   (congoleseProfiles/{request.auth.uid}). This only resolves correctly if a
//   profile document exists at that exact path. Today's signup flow does not
//   guarantee that (see summary). Until that's addressed, an admin's profile
//   document must be created/copied so its document ID equals their Auth uid.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function isSignedIn() {
      return request.auth != null;
    }

    function isNonEmptyString(value) {
      return value is string && value.size() > 0;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/congoleseProfiles/$(request.auth.uid))
        && get(/databases/$(database)/documents/congoleseProfiles/$(request.auth.uid)).data.role == "admin";
    }

    // Backs the 'verified-only' profile visibility option (Phase 3) — same
    // canonical doc-ID-equals-Auth-UID lookup as isAdmin(), just checking
    // status instead of role.
    function callerIsVerified() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/congoleseProfiles/$(request.auth.uid))
        && get(/databases/$(database)/documents/congoleseProfiles/$(request.auth.uid)).data.status == "verified";
    }

    // Blocks an admin from demoting or suspending themselves via the User
    // Management page — losing the admin role (or getting suspended) on
    // your own account, by accident, mid-review-session, would otherwise
    // lock you out with no other admin necessarily around to undo it.
    // Only applies to profileId == the caller's own uid; admins can still
    // freely demote/suspend *other* admins.
    function isSelfLockout(profileId) {
      return request.auth.uid == profileId
        && (
          request.resource.data.role != resource.data.role
          || (request.resource.data.status == "suspended" && resource.data.status != "suspended")
        );
    }

    // National Digital Identity fields (citizenId, memberNumber,
    // registrationDate) are generated once by generateCitizenIdentity()
    // (src/services/identityService.js) and must never change afterward,
    // even by their own owner — a citizen ID that could be edited client-side
    // wouldn't be trustworthy. True (not present yet, i.e. first-time
    // generation) or unchanged; false if it would actually modify an
    // existing value.
    function isValidIdentityFieldChange(field) {
      return !(field in resource.data) || request.resource.data[field] == resource.data[field];
    }

    // Shared validation for the "Create*" pages (jobs, events, scholarships,
    // news, businesses, announcements), which all follow the same shape:
    // authenticated create, createdBy set to the author's own email, a
    // required non-empty primary text field, and status fixed to "published".
    function validPublishedCreate(primaryField) {
      return isSignedIn()
        && request.resource.data.createdBy == request.auth.token.email
        && request.resource.data.status == "published"
        && request.resource.data.createdAt is timestamp
        && isNonEmptyString(request.resource.data[primaryField]);
    }

    // ---------- Deny everything by default ----------
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------- congoleseProfiles ----------
    // Public directory data, but contains PII (phone, DOB, village/province,
    // photo) — restricted to signed-in users rather than the public internet.
    // Phase 3 adds a `visibility` field (private/verified-only/public,
    // default public for any profile that predates this field, so nothing
    // existing loses visibility). Owner and admins can always read their
    // own/any profile regardless of visibility; a collection query (e.g.
    // SearchUsers.jsx fetching the whole collection) simply omits documents
    // the caller isn't allowed to see rather than erroring, so this cascades
    // privacy everywhere without touching those pages.
    match /congoleseProfiles/{profileId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid)
        || !('visibility' in resource.data)
        || resource.data.visibility == 'public'
        || (resource.data.visibility == 'verified-only' && callerIsVerified());

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && isNonEmptyString(request.resource.data.email)
        && isNonEmptyString(request.resource.data.firstName)
        && isNonEmptyString(request.resource.data.lastName)
        && request.resource.data.role == "citizen"
        && request.resource.data.status == "pending_verification";

      // Admins may change anything (status, role, verification, etc).
      // Otherwise: the profile owner may edit their own contact/bio fields,
      // but role/status/userId/email can never be touched by them — this is
      // what stops a user from self-promoting to admin.
      // Separately, ANY signed-in user may update only the `followers` field,
      // which is how the follow/unfollow feature writes to *other* profiles.
      allow update: if (isAdmin() && !isSelfLockout(profileId))
        || (
          isSignedIn() && resource.data.userId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'firstName', 'middleName', 'lastName', 'preferredName', 'gender',
            'placeOfBirth', 'nationality', 'phone',
            'province', 'territory', 'village', 'currentCountry', 'currentCity',
            'profileImageUrl', 'followers', 'emergencyContact', 'visibility',
            'citizenId', 'memberNumber', 'registrationDate', 'notificationPreferences'
          ])
          && isValidIdentityFieldChange('citizenId')
          && isValidIdentityFieldChange('memberNumber')
          && isValidIdentityFieldChange('registrationDate')
        )
        || (
          isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followers'])
        );

      allow delete: if isAdmin();
    }

    // ---------- communityPosts ----------
    match /communityPosts/{postId} {
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && isNonEmptyString(request.resource.data.text)
        && request.resource.data.likes == 0
        && request.resource.data.comments == [];

      // Owner may edit their own text/image; any signed-in user may like
      // (increment) or comment (array append) on any post; admins can do
      // anything (moderation).
      // NOTE: comments are stored as a raw array field rather than a
      // subcollection, so rules can only check *which field* changed, not
      // that an edit/delete only touched the requester's own comment entry.
      // See summary for the residual risk and recommended follow-up.
      allow update: if isAdmin()
        || (
          isSignedIn() && resource.data.userId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'imageUrl', 'updatedAt'])
        )
        || (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']))
        || (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments']));

      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // ---------- issues ----------
    match /issues/{issueId} {
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && isNonEmptyString(request.resource.data.title)
        && isNonEmptyString(request.resource.data.description)
        && request.resource.data.status == "pending_review"
        && request.resource.data.supportVotes == 0
        && request.resource.data.opposeVotes == 0;

      // Same residual risk as communityPosts.comments — see note above.
      allow update: if isAdmin()
        || (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['supportVotes']))
        || (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['opposeVotes']))
        || (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments']));

      allow delete: if isAdmin();
    }

    // ---------- jobs ----------
    // Employer-owned postings with an admin-approval gate: a regular
    // employer's new post starts 'pending_approval' and only becomes
    // publicly readable once an admin flips it to 'published' — mirrors the
    // government-service application status-machine pattern. Employers can
    // edit their own post's content while pending, and close (but not
    // reopen) a published post; only admins can approve/reject/remove.
    // applicantCount is deliberately NOT stored here — an applicant
    // successfully creating a jobApplications doc has no write access to
    // the parent job doc, so counting is done by querying jobApplications
    // instead of trying to make this doc writable by non-owners.
    match /jobs/{jobId} {
      allow read: if resource.data.status == 'published'
        || isAdmin()
        || (isSignedIn() && resource.data.employerId == request.auth.uid);

      allow create: if isSignedIn()
        && request.resource.data.employerId == request.auth.uid
        && request.resource.data.employerEmail == request.auth.token.email
        && isNonEmptyString(request.resource.data.title)
        && isNonEmptyString(request.resource.data.description)
        && isNonEmptyString(request.resource.data.companyName)
        && request.resource.data.status == 'pending_approval'
        && request.resource.data.rejectionReason == ''
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.keys().hasOnly([
             'employerId', 'employerEmail', 'companyName', 'title', 'description',
             'category', 'type', 'locationType', 'location', 'experienceLevel',
             'salaryRange', 'status', 'rejectionReason', 'createdAt', 'updatedAt', 'closedAt'
           ]);

      allow update: if isAdmin()
        || (
          isSignedIn() && resource.data.employerId == request.auth.uid
          && request.resource.data.employerId == resource.data.employerId
          && request.resource.data.employerEmail == resource.data.employerEmail
          && request.resource.data.createdAt == resource.data.createdAt
          && (
            (resource.data.status == 'pending_approval' && request.resource.data.status == 'pending_approval')
            || (resource.data.status == 'published' && request.resource.data.status in ['published', 'closed'])
            || (resource.data.status == 'closed' && request.resource.data.status == 'closed')
          )
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'title', 'description', 'category', 'type', 'locationType', 'location',
               'experienceLevel', 'salaryRange', 'status', 'updatedAt', 'closedAt'
             ])
        );

      allow delete: if isAdmin();
    }

    // ---------- companies ----------
    // One lightweight employer/company profile per employer, doc ID == the
    // employer's Auth uid (same canonical pattern as congoleseProfiles'
    // isAdmin() lookup). `verified` is admin-only — an employer can never
    // self-verify.
    match /companies/{companyId} {
      allow read: if true;

      allow create: if isSignedIn()
        && companyId == request.auth.uid
        && request.resource.data.employerId == request.auth.uid
        && isNonEmptyString(request.resource.data.name)
        && request.resource.data.verified == false
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.keys().hasOnly([
             'employerId', 'name', 'description', 'website', 'logoUrl',
             'industry', 'verified', 'createdAt', 'updatedAt'
           ]);

      allow update: if isAdmin()
        || (
          isSignedIn() && companyId == request.auth.uid
          && request.resource.data.employerId == resource.data.employerId
          && request.resource.data.verified == resource.data.verified
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'name', 'description', 'website', 'logoUrl', 'industry', 'updatedAt'
             ])
        );

      allow delete: if isAdmin();
    }

    // ---------- jobApplications ----------
    // Doc ID = `${jobId}_${applicantUserId}` — deterministic, so a second
    // apply attempt on the same job by the same applicant lands on an
    // *update* (rejected by the rules below, since the applicant branch
    // only allows applied -> withdrawn) rather than silently creating a
    // duplicate — the same dedupe trick used for messaging conversations.
    // employerId is denormalized from the job at creation time so employer
    // read/update access never needs a second get() beyond the one already
    // required to validate the create itself.
    match /jobApplications/{applicationId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.applicantUserId == request.auth.uid)
        || (isSignedIn() && resource.data.employerId == request.auth.uid);

      allow create: if isSignedIn()
        && applicationId == request.resource.data.jobId + '_' + request.auth.uid
        && request.resource.data.applicantUserId == request.auth.uid
        && request.resource.data.applicantEmail == request.auth.token.email
        && request.resource.data.employerId
             == get(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data.employerId
        && get(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data.status == 'published'
        && isNonEmptyString(request.resource.data.applicantFullName)
        && request.resource.data.status == 'applied'
        && request.resource.data.interviewInstructions == ''
        && request.resource.data.reviewedAt == null
        && request.resource.data.reviewedBy == null
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.keys().hasOnly([
             'jobId', 'jobTitle', 'companyName', 'employerId', 'applicantUserId', 'applicantEmail', 'applicantFullName',
             'resumeCloudinaryPublicId', 'resumeResourceType', 'resumeFileName', 'coverLetter', 'status',
             'interviewInstructions', 'reviewedAt', 'reviewedBy', 'createdAt', 'updatedAt'
           ]);

      allow update: if isAdmin()
        || (
          // Employer reviews: status transitions + interview instructions.
          isSignedIn() && resource.data.employerId == request.auth.uid
          && request.resource.data.applicantUserId == resource.data.applicantUserId
          && request.resource.data.employerId == resource.data.employerId
          && request.resource.data.jobId == resource.data.jobId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.status in ['under_review', 'interview', 'offered', 'rejected']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'status', 'interviewInstructions', 'reviewedAt', 'reviewedBy', 'updatedAt'
             ])
        )
        || (
          // Applicant withdraws — only while still in the initial 'applied'
          // state, matching "withdraw before review" in the spec.
          isSignedIn() && resource.data.applicantUserId == request.auth.uid
          && resource.data.status == 'applied'
          && request.resource.data.status == 'withdrawn'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        );

      allow delete: if isAdmin();
    }

    // ---------- jobReports ----------
    match /jobReports/{reportId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.reporterId == request.auth.uid);

      allow create: if isSignedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.reporterEmail == request.auth.token.email
        && isNonEmptyString(request.resource.data.jobId)
        && request.resource.data.reason in ['fraud', 'expired', 'misleading', 'spam', 'other']
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.keys().hasOnly([
             'jobId', 'reporterId', 'reporterEmail', 'reason', 'message',
             'status', 'createdAt', 'reviewedBy', 'reviewedAt', 'adminNotes'
           ]);

      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ---------- events / scholarships ----------
    // Public listings, open authenticated create, admin-only edit/remove
    // (no owner-edit UI exists for these today).
    match /events/{eventId} {
      allow read: if true;
      allow create: if validPublishedCreate('title');
      allow update, delete: if isAdmin();
    }

    match /scholarships/{scholarshipId} {
      allow read: if true;
      allow create: if validPublishedCreate('title');
      allow update, delete: if isAdmin();
    }

    match /news/{newsId} {
      allow read: if true;
      allow create: if validPublishedCreate('title')
        && isNonEmptyString(request.resource.data.summary)
        && isNonEmptyString(request.resource.data.content);
      allow update, delete: if isAdmin();
    }

    match /businesses/{businessId} {
      allow read: if true;
      allow create: if validPublishedCreate('name')
        && isNonEmptyString(request.resource.data.category)
        && isNonEmptyString(request.resource.data.country);
      allow update, delete: if isAdmin();
    }

    // NOTE: matches current app behavior — CreateAnnouncement.jsx lets any
    // signed-in user post an announcement, not just admins. Flagged in the
    // summary as worth tightening to isAdmin()-only creates if these are
    // meant to be official platform announcements.
    match /announcements/{announcementId} {
      allow read: if true;
      allow create: if validPublishedCreate('title')
        && isNonEmptyString(request.resource.data.message);
      allow update, delete: if isAdmin();
    }

    // ---------- identityDocuments ----------
    // Sensitive: government ID uploads. Owner and admins only, ever.
    // Phase 2 schema: documentType/status carry the full verification
    // workflow (draft -> submitted -> under_review -> approved/rejected/
    // more_information_required -> replaced). citizenId is cross-checked
    // against the caller's own profile (doc ID == Auth UID, same canonical
    // pattern as isAdmin()) so it can't be spoofed to point at someone
    // else's identity. Older documents written before this schema (plain
    // pending_review/approved/rejected, no documentType) remain readable
    // and admin-writable under this same match block — no migration
    // required, matches the lazy-backfill approach used elsewhere.
    function isValidDocumentTypeSubmit() {
      return request.resource.data.documentType in [
        'national_id', 'passport', 'birth_certificate', 'driver_license',
        'residence_permit', 'refugee_card', 'student_id', 'selfie', 'other'
      ];
    }

    match /identityDocuments/{documentId} {
      // resource != null guards a read of a deleted/nonexistent document —
      // without it, resource.data throws an evaluation error instead of a
      // clean deny (discovered via a test that reads a doc right after
      // deleting it, e.g. to confirm the delete worked).
      allow read: if isAdmin() || (isSignedIn() && resource != null && resource.data.userId == request.auth.uid);

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.citizenId
             == get(/databases/$(database)/documents/congoleseProfiles/$(request.auth.uid)).data.citizenId
        && isValidDocumentTypeSubmit()
        && isNonEmptyString(request.resource.data.cloudinaryPublicId)
        && isNonEmptyString(request.resource.data.fileType)
        && request.resource.data.fileSize is number
        && request.resource.data.fileSize > 0
        && request.resource.data.fileSize <= 10485760
        && request.resource.data.status in ['draft', 'submitted']
        && request.resource.data.submittedAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.reviewerId == null
        && request.resource.data.reviewedAt == null
        && request.resource.data.keys().hasOnly([
             'userId', 'citizenId', 'email', 'documentType', 'documentNumber',
             'issuingCountry', 'issueDate', 'expirationDate', 'cloudinaryPublicId',
             'resourceType', 'fileType', 'fileSize', 'submittedAt', 'updatedAt',
             'status', 'rejectionReason', 'requestMoreInfoMessage', 'reviewerId',
             'reviewedAt', 'replacesDocumentId', 'ownerResponseMessage'
           ]);

      // Admins may change anything (review decisions, etc). Otherwise, the
      // owner may only touch a document that isn't actively under review or
      // already decided-and-final:
      //  - draft -> draft (keep editing) or draft -> submitted (submit)
      //  - rejected -> replaced (paired with creating a new doc client-side)
      //  - more_information_required -> submitted (respond in place) or
      //    -> replaced (upload a new file instead)
      // reviewerId/reviewedAt/submittedAt/userId/citizenId can never be
      // touched by the owner — those are either admin-only or immutable
      // history.
      allow update: if isAdmin()
        || (
          isSignedIn() && resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.citizenId == resource.data.citizenId
          && request.resource.data.reviewerId == resource.data.reviewerId
          && request.resource.data.reviewedAt == resource.data.reviewedAt
          && request.resource.data.submittedAt == resource.data.submittedAt
          && (
            (resource.data.status == 'draft' && request.resource.data.status in ['draft', 'submitted'])
            || (resource.data.status == 'rejected' && request.resource.data.status == 'replaced')
            || (resource.data.status == 'more_information_required'
                && request.resource.data.status in ['submitted', 'replaced'])
          )
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'documentType', 'documentNumber', 'issuingCountry', 'issueDate',
               'expirationDate', 'cloudinaryPublicId', 'resourceType', 'fileType',
               'fileSize', 'status', 'updatedAt', 'ownerResponseMessage'
             ])
        );

      // Only a draft (never submitted) may be deleted by its owner; admins
      // may remove any submission.
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid && resource.data.status == 'draft');

      // Internal admin notes on a submission — never visible to the owner,
      // even though the owner can read the parent document. Append-only.
      match /reviewNotes/{noteId} {
        allow read: if isAdmin();

        allow create: if isAdmin()
          && request.resource.data.authorId == request.auth.uid
          && isNonEmptyString(request.resource.data.message)
          && request.resource.data.createdAt is timestamp
          && request.resource.data.keys().hasOnly(['authorId', 'authorEmail', 'message', 'createdAt']);

        allow update, delete: if false;
      }
    }

    // ---------- verificationAuditLogs ----------
    // Append-only trail of every identity-verification-related event
    // (upload, submission, review started, approval, rejection, request for
    // more info, replacement, deletion, profile verification change, card
    // reissue). Admin-readable always; Phase 3 also lets the citizen an
    // entry is ABOUT read their own history (Identity Dashboard "recent
    // activity") — never any other citizen's. Internal admin notes
    // (identityDocuments/{id}/reviewNotes) stay admin-only and separate from
    // this, so nothing reviewer-private leaks through here. actorRole is
    // cross-checked against the real caller so a citizen can't write a log
    // entry claiming to be an admin.
    match /verificationAuditLogs/{logId} {
      // No `resource != null` guard needed here (unlike identityDocuments):
      // audit log entries are never deleted (delete: if false below), so a
      // read-after-delete null-resource case can't occur for this collection.
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);

      allow create: if isSignedIn()
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.userId is string
        && request.resource.data.type in [
             'upload', 'submission', 'review_started', 'approval', 'rejection',
             'request_more_info', 'document_replacement', 'deletion',
             'profile_verification_change', 'card_reissued'
           ]
        && request.resource.data.createdAt is timestamp
        && request.resource.data.keys().hasOnly([
             'type', 'documentId', 'userId', 'actorId', 'actorRole', 'message', 'createdAt'
           ])
        && (
          (request.resource.data.actorRole == 'citizen' && request.resource.data.userId == request.auth.uid)
          || (request.resource.data.actorRole == 'admin' && isAdmin())
        );

      allow update, delete: if false;
    }

    // ---------- publicVerifications ----------
    // Minimal public-safe mirror of a verified/pending identity, keyed by
    // citizenId. Firestore rules are document-level, not field-level, so
    // this is the only way to let /verify/:citizenId be readable by anyone
    // without exposing the full congoleseProfiles document (email, phone,
    // DOB, documents, etc). Created by the owner the moment their citizenId
    // is generated (see identityService.js); display fields (name/photo)
    // stay owner-editable, but status/verifiedAt/verifiedBy are admin-only —
    // a citizen must never be able to mark their own public page "verified".
    match /publicVerifications/{citizenId} {
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.citizenId == citizenId
        && request.resource.data.status is string
        && request.resource.data.keys().hasOnly([
             'userId', 'citizenId', 'firstName', 'lastName', 'preferredName',
             'profileImageUrl', 'status', 'registrationDate', 'verifiedAt', 'verifiedBy',
             'province', 'currentCountry'
           ]);

      // province/currentCountry are owner-editable display fields, same as
      // name/photo — optional-to-show on the public verify page (Phase 3),
      // never a substitute for the full private address on congoleseProfiles.
      allow update: if isAdmin()
        || (
          isSignedIn() && resource.data.userId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['firstName', 'lastName', 'preferredName', 'profileImageUrl', 'province', 'currentCountry'])
        );

      allow delete: if isAdmin();
    }

    // ---------- serviceApplications ----------
    // Government service application workflow. Deliberately one collection
    // with a `serviceType` field rather than one collection per service, so
    // each new service reuses the same review/audit infrastructure without
    // a schema change — isValidServiceType() below is the whitelist to
    // extend when a new service is added. Field allowlists below are a
    // union across all service types (each service only ever writes its
    // own subset). Documents are never government-issued by this platform;
    // that's enforced in the UI copy, not here.
    function isValidServiceType() {
      return request.resource.data.serviceType in ['birth_certificate', 'passport'];
    }

    match /serviceApplications/{applicationId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.applicantUserId == request.auth.uid);

      allow create: if isSignedIn()
        && request.resource.data.applicantUserId == request.auth.uid
        && request.resource.data.applicantEmail == request.auth.token.email
        && request.resource.data.citizenId
             == get(/databases/$(database)/documents/congoleseProfiles/$(request.auth.uid)).data.citizenId
        && isValidServiceType()
        && isNonEmptyString(request.resource.data.applicantFullName)
        && request.resource.data.status in ['draft', 'submitted']
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.reviewerId == null
        && request.resource.data.reviewedAt == null
        && request.resource.data.keys().hasOnly([
             'applicantUserId', 'applicantEmail', 'serviceType', 'citizenId', 'memberNumber',
             'applicantFullName', 'dateOfBirth', 'placeOfBirth', 'provinceOfBirth', 'territoryOfBirth',
             'fatherFullName', 'motherFullName', 'reasonForRequest', 'deliveryPreference',
             'passportType', 'applicationMode', 'currentPassportNumber',
             'currentPassportIssueDate', 'currentPassportExpirationDate',
             'emergencyContactName', 'emergencyContactPhone',
             'supportingDocuments', 'status', 'submittedAt', 'reviewedAt', 'reviewedBy', 'reviewerId',
             'rejectionReason', 'requestMoreInfoMessage', 'createdAt', 'updatedAt'
           ]);

      // Admins may change anything (review decisions, etc). Otherwise the
      // applicant may only touch their OWN application while it's still in
      // an editable state:
      //  - draft -> draft (keep editing), draft -> submitted (submit), or
      //    draft -> withdrawn (give up before ever submitting)
      //  - submitted -> withdrawn (withdraw before review begins — once an
      //    admin marks it under_review, withdrawal is no longer allowed)
      //  - more_information_required -> submitted (add documents / edit
      //    fields and resubmit)
      // reviewerId/reviewedAt/reviewedBy/rejectionReason/
      // requestMoreInfoMessage are always admin-only; applicantUserId/
      // citizenId/serviceType/createdAt are immutable history.
      allow update: if isAdmin()
        || (
          isSignedIn() && resource.data.applicantUserId == request.auth.uid
          && request.resource.data.applicantUserId == resource.data.applicantUserId
          && request.resource.data.citizenId == resource.data.citizenId
          && request.resource.data.reviewerId == resource.data.reviewerId
          && request.resource.data.reviewedAt == resource.data.reviewedAt
          && request.resource.data.createdAt == resource.data.createdAt
          && (
            (resource.data.status == 'draft' && request.resource.data.status in ['draft', 'submitted', 'withdrawn'])
            || (resource.data.status == 'submitted' && request.resource.data.status == 'withdrawn')
            || (resource.data.status == 'more_information_required' && request.resource.data.status == 'submitted')
          )
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'applicantFullName', 'dateOfBirth', 'placeOfBirth', 'provinceOfBirth', 'territoryOfBirth',
               'fatherFullName', 'motherFullName', 'reasonForRequest', 'deliveryPreference',
               'passportType', 'applicationMode', 'currentPassportNumber',
               'currentPassportIssueDate', 'currentPassportExpirationDate',
               'emergencyContactName', 'emergencyContactPhone',
               'supportingDocuments', 'status', 'submittedAt', 'updatedAt'
             ])
        );

      allow delete: if isAdmin();

      // Internal admin notes — never visible to the applicant, even though
      // they can read the parent application. Append-only.
      match /reviewNotes/{noteId} {
        allow read: if isAdmin();

        allow create: if isAdmin()
          && request.resource.data.authorId == request.auth.uid
          && isNonEmptyString(request.resource.data.message)
          && request.resource.data.createdAt is timestamp
          && request.resource.data.keys().hasOnly(['authorId', 'authorEmail', 'message', 'createdAt']);

        allow update, delete: if false;
      }
    }

    // ---------- serviceApplicationAuditLogs ----------
    // Append-only trail for the government service application workflow —
    // same shape and guarantees as verificationAuditLogs, kept as a
    // separate collection since its event vocabulary (application
    // creation/submission/withdrawal) is specific to this workflow rather
    // than identity verification.
    match /serviceApplicationAuditLogs/{logId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);

      allow create: if isSignedIn()
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.userId is string
        && request.resource.data.applicationId is string
        && request.resource.data.type in [
             'creation', 'submission', 'review_started', 'approval', 'rejection',
             'request_more_info', 'withdrawal'
           ]
        && request.resource.data.createdAt is timestamp
        && request.resource.data.keys().hasOnly([
             'type', 'applicationId', 'userId', 'actorId', 'actorRole', 'message', 'createdAt'
           ])
        && (
          (request.resource.data.actorRole == 'citizen' && request.resource.data.userId == request.auth.uid)
          || (request.resource.data.actorRole == 'admin' && isAdmin())
        );

      allow update, delete: if false;
    }

    // ---------- conversations ----------
    // One doc per participant pair, ID = sorted([uidA, uidB]).join('_') —
    // deterministic so getOrCreateConversation() can prevent duplicate
    // conversation records with a get-inside-transaction instead of a
    // separate uniqueness index. Holds only the metadata needed for a
    // conversation list (last message preview, per-participant unread
    // count); the messages themselves live in the messages collection.
    match /conversations/{conversationId} {
      // `resource == null` (doc doesn't exist yet) must be allowed through —
      // getOrCreateConversation()'s transaction does a get() on a brand-new
      // pair's doc before creating it, and a nonexistent doc has nothing to
      // leak, so there's no access-control reason to deny that read.
      allow read: if isSignedIn()
        && (resource == null || request.auth.uid in resource.data.participants);

      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants[0] != request.resource.data.participants[1]
        && request.resource.data.lastMessage == null
        && request.resource.data.unreadCount is map
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.keys().hasOnly(['participants', 'lastMessage', 'unreadCount', 'createdAt', 'updatedAt']);

      // Only sendMessage()/markConversationRead() touch an existing
      // conversation — bumping the preview/unread counters. Participants
      // and history are immutable once created.
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'unreadCount', 'updatedAt']);

      allow delete: if false;
    }

    // ---------- messages ----------
    // Individual messages within a conversation. senderId/recipientId are
    // Auth uids (not emails) so read/write ownership checks are simple uid
    // equality rather than a token-email lookup.
    match /messages/{messageId} {
      allow read: if isSignedIn()
        && (request.auth.uid == resource.data.senderId || request.auth.uid == resource.data.recipientId);

      allow create: if isSignedIn()
        && request.resource.data.senderId == request.auth.uid
        && isNonEmptyString(request.resource.data.recipientId)
        && request.resource.data.recipientId != request.auth.uid
        && isNonEmptyString(request.resource.data.conversationId)
        && isNonEmptyString(request.resource.data.text)
        && request.resource.data.read == false
        && request.resource.data.createdAt is timestamp
        && request.resource.data.keys().hasOnly(['conversationId', 'senderId', 'recipientId', 'text', 'read', 'createdAt']);

      // Only the recipient may flip `read` to true — a read receipt, not an
      // edit. Nothing else about a sent message can ever change.
      allow update: if isSignedIn()
        && request.auth.uid == resource.data.recipientId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read == true;

      allow delete: if false;
    }

    // ---------- notifications ----------
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.to == request.auth.token.email;

      // Two ways a notification gets created:
      //  - Admin actions (verification approve/reject, service application
      //    review) — any `type`, no self-attribution required.
      //  - A regular signed-in user, but only for the specific self-service
      //    types they can legitimately trigger themselves (a new message, a
      //    new follower) and only attributed to their own uid — so a user
      //    can't forge a notification claiming to be from someone else or
      //    impersonate an admin-only notification type.
      // Either way: to/message are required, and it always starts unread
      // regardless of what's sent.
      allow create: if isNonEmptyString(request.resource.data.to)
        && isNonEmptyString(request.resource.data.message)
        && request.resource.data.read == false
        && request.resource.data.createdAt is timestamp
        && request.resource.data.keys().hasOnly(['to', 'from', 'fromUserId', 'type', 'message', 'relatedRoute', 'read', 'createdAt'])
        && (
          isAdmin()
          || (
            isSignedIn()
            && request.resource.data.type in ['New Message', 'New Follower', 'Job Application Update']
            && request.resource.data.fromUserId == request.auth.uid
          )
        );

      // Recipient may only flip `read` to true; nothing else.
      allow update: if isSignedIn()
        && resource.data.to == request.auth.token.email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read == true;

      allow delete: if isAdmin() || (isSignedIn() && resource.data.to == request.auth.token.email);
    }

    // ---------- savedItems ----------
    match /savedItems/{itemId} {
      allow read: if isSignedIn() && resource.data.userEmail == request.auth.token.email;

      allow create: if isSignedIn() && request.resource.data.userEmail == request.auth.token.email;

      allow update: if isSignedIn()
        && resource.data.userEmail == request.auth.token.email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['removed']);

      allow delete: if isSignedIn() && resource.data.userEmail == request.auth.token.email;
    }

    // ---------- congoGalleryItems ----------
    // Public knowledge/media database (music, politics, history, cities,
    // nature, sports, culture). Anyone can read published content; only
    // admins can write. This is Phase 4's end-state write model, adopted
    // now rather than a temporary deny-all-writes placeholder, because it
    // lets an admin seed/manage this collection from their own
    // authenticated session — no separate service-account script needed.
    // Deep per-field validation (allowed-field allowlists, category-aware
    // required fields) is deferred to Phase 4 alongside the Admin CMS.
    match /congoGalleryItems/{itemId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ---------- counters ----------
    // Backs sequential Citizen ID / Member Number generation
    // (src/services/identityService.js) via an atomic Firestore
    // transaction. Deliberately allows any signed-in user to write, but
    // only ever by exactly +1 — a client-side counter has to trust the
    // caller not to jump or reset the value, so the rule enforces the one
    // operation that's actually safe rather than gating on isAdmin(),
    // since every citizen needs to be able to claim their own next number.
    // create only fires once, the very first time the counter doc doesn't
    // exist yet, and only at the correct starting value.
    match /counters/{counterId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['value'])
        && request.resource.data.value == 1;

      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['value'])
        && request.resource.data.value == resource.data.value + 1;

      allow delete: if false;
    }

    // ---------- accountDeletionRequests ----------
    // A citizen-submitted request only — never triggers an automatic
    // deletion. An admin reviews and actions it manually, then marks it
    // resolved. See serviceApplications for the same "request, not
    // automatic action" pattern.
    match /accountDeletionRequests/{requestId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.resolvedAt == null
        && request.resource.data.resolvedBy == null
        && request.resource.data.keys().hasOnly([
             'userId', 'email', 'reason', 'status', 'createdAt', 'resolvedAt', 'resolvedBy'
           ]);

      // Only an admin can mark a request resolved/cancelled; the requester
      // can never edit their own submitted request.
      allow update: if isAdmin()
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.status in ['resolved', 'cancelled']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolvedAt', 'resolvedBy']);

      allow delete: if false;
    }
  }
}
